{
    "name": "renatio/dynamicpdf-plugin",
    "type": "october-plugin",
    "description": "Generate PDFs in October CMS from HTML and Twig templates edited in the backend, with layouts, page numbers, password protection and file output.",
    "homepage": "https://octobercms.com/plugin/renatio-dynamicpdf",
    "keywords": [
        "octobercms-plugin",
        "octobercms",
        "php",
        "laravel",
        "pdf",
        "dompdf"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Michal Plodowski",
            "email": "michal.plodowski@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "october/rain": "^4.0",
        "barryvdh/laravel-dompdf": "^3.1"
    },
    "require-dev": {
        "laravel/pao": "^1.1",
        "larastan/larastan": "^3.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0"
    },
    "scripts": {
        "stan": "../../../vendor/bin/phpstan analyse --memory-limit=1G",
        "rector": "../../../vendor/bin/rector process --dry-run",
        "rector:fix": "../../../vendor/bin/rector process"
    }
}
